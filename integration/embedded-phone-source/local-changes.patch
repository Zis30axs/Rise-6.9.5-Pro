+// Derive the visible iframe geometry from the actual host-applied styles. Its
+// layout viewport must stay fixed while the one CSS scale affects both axes.
+function assertContainedPhone(f) {
+  const value = name => f.frame.style.getPropertyValue(name);
+  assert.equal(f.panel.style.getPropertyValue('background'), 'transparent', 'unused slot space must not paint a dialog backdrop');
+  assert.equal(f.panel.style.getPropertyValue('pointer-events'), 'none', 'unused slot space must not intercept scene clicks');
+  assert.equal(value('pointer-events'), 'auto', 'the fitted phone itself must remain interactive');
+  const width = parseFloat(value('width')), height = parseFloat(value('height'));
+  assert.equal(width, 390);
+  assert.equal(height, 844);
+  assert.equal(value('position'), 'absolute');
+  assert.equal(value('transform-origin'), '0 0');
+  const scaleMatch = /^scale\(([\d.e+-]+)\)$/.exec(value('transform'));
+  assert.ok(scaleMatch, 'the entire iframe uses one uniform scale');
+  const scale = Number(scaleMatch[1]);
+  const left = parseFloat(value('left')), top = parseFloat(value('top'));
+  const bounds = f.anchor.getBoundingClientRect();
+  const presented = {left, top, width: width * scale, height: height * scale};
+  const closeTo = (actual, expected) => assert.ok(Math.abs(actual - expected) < 1e-8, `${actual} should equal ${expected}`);
+  closeTo(scale, Math.min(bounds.width / 390, bounds.height / 844));
+  closeTo(presented.width / presented.height, 390 / 844);
+  closeTo(left, (bounds.width - presented.width) / 2);
+  closeTo(top, (bounds.height - presented.height) / 2);
+  assert.ok(left >= -1e-8 && top >= -1e-8, 'top and left edges stay inside the slot');
+  assert.ok(left + presented.width <= bounds.width + 1e-8 && top + presented.height <= bounds.height + 1e-8, 'bottom and right edges stay inside the slot');
+  return {scale, ...presented};
+}
